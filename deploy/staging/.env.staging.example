# Copy to ~/zenlot-staging/.env.staging ON THE STAGING VM and fill in. Never commit the real file.
# Generate secrets with: openssl rand -base64 48
# These must NOT be reused from production.

STAGING_DOMAIN=staging-api.zenlot.net

# Hosted Prisma Postgres: the same prisma+postgres://... value as DEV_PRISMA_DB in .env.dev
# (`prisma migrate deploy` runs on every deploy and accepts it; so does the API at runtime).
# This is the Prisma Postgres "dev" database, used only by staging; see docs/STAGING.md.
DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d

CORS_ORIGIN=https://staging-api.zenlot.net

# E2E flows sign up many users from a few CI IPs; the default (100/min per IP) would trip.
RATE_LIMIT_MAX_REQUESTS=10000
RATE_LIMIT_WINDOW_MS=60000

SWAGGER_ENABLED=true

# Sent from Mailpit, so any address works. Nothing is delivered externally.
EMAIL_FROM=staging@zenlot.net
APP_URL=zenlot://

# Leave blank: AI coaching is skipped without these, and staging should not spend money.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Market data: use free/low-rate keys, separate from production where the provider allows.
TWELVEDATA_API_KEY=
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice
FMP_API_KEY=
FINAGE_API_KEY=
MASSIVE_API_KEY=
UNIRATE_API_KEY=

# Optional: a separate Sentry project / no Mixpanel keeps staging out of prod dashboards.
SENTRY_DSN=
MIXPANEL_TOKEN=
EXPO_ACCESS_TOKEN=
