// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model trade {
  id                 String    @id @default(uuid())
  user               user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  symbol             String
  userId             String
  entry              Float
  lot                Float
  pips               Float
  execution          String
  accountCurrency    String
  exchangeRate       Float
  rr                 Float
  risk               Float
  reward             Float
  tags               String[]
  stopLoss           Json
  takeProfit         Json
  plainText          String?
  editorState        String?
  status             String    @default("open")
  closedAt           DateTime?
  closedPrice        Float?
  closedExchangeRate Float?
  closedReason       String?
  isAutoClosed       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  journal            journal[]

  @@index([userId])
  @@index([status, symbol])
}

model journal {
  id          String   @id @default(uuid())
  userId      String
  symbol      String
  title       String?
  tradeId     String?
  plainText   String?
  trade       trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  editorState String?
  tags        String[]
  author      user     @relation("UserJournal", fields: [userId], references: [id], onDelete: Cascade)
  isPinned    Boolean? @default(false)
  isArchived  Boolean? @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([tradeId])
}

model user {
  id                           String         @id @default(uuid())
  fname                        String         @db.VarChar(256)
  lname                        String         @db.VarChar(256)
  email                        String         @unique @db.VarChar(256)
  role                         String
  tags                         String[]
  language                     String
  password                     String
  accountCurrency              String
  theme                        String         @default("system")
  rules                        Json
  journalEntries               journal[]      @relation("UserJournal")
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  trade                        trade[]
  timezone                     String         @default("UTC")
  togglePipValue               Boolean        @default(false)
  refreshTokens                RefreshToken[]
  auditLogs                    auditLog[]
  deletedAt                    DateTime?
  deleteScheduledFor           DateTime?
  emailVerified                Boolean        @default(false)
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  @@index([userId])
}

model auditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       user?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model feedback {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  subject   String
  message   String
  type      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
