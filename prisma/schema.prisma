// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("LOCAL_DB_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model trade {
  id                 Int       @id @default(autoincrement())
  user               user      @relation(fields: [userId], references: [id], onUpdate: NoAction)
  symbol             String
  userId             Int
  entry              Float
  lot                Float
  pips               Float
  execution          String
  accountCurrency    String
  exchangeRate       Float
  rr                 Float
  risk               Float
  reward             Float
  tags               String[]
  stopLoss           Json
  takeProfit         Json
  plainText          String?
  editorState        String?
  status             String    @default("open")
  closedAt           DateTime?
  closedPrice        Float?
  closedExchangeRate Float?
  closedReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  journal            journal[]
}

model journal {
  id          Int      @id @default(autoincrement())
  userId      Int
  symbol      String
  title       String?
  tradeId     Int?
  plainText   String?
  trade       trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  editorState String?
  tags        String[]
  author      user     @relation("UserJournal", fields: [userId], references: [id], onDelete: Cascade)
  isPinned    Boolean? @default(false)
  isArchived  Boolean? @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model user {
  id              Int            @id @default(autoincrement())
  fname           String
  lname           String
  email           String         @unique
  role            String
  tags            String[]
  language        String
  password        String
  accountCurrency String
  theme           String         @default("system")
  rules           Json
  journalEntries  journal[]      @relation("UserJournal")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  trade           trade[]
  timezone        String         @default("UTC")
  togglePipValue  Boolean        @default(false)
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)
}
