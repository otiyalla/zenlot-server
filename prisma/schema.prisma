// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model trade {
  id                 String    @id @default(uuid())
  user               user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  symbol             String
  userId             String
  entry              Float
  lot                Float
  pips               Float
  execution          String
  accountCurrency    String
  exchangeRate       Float
  rr                 Float
  risk               Float
  reward             Float
  tags               String[]
  stopLoss           Json
  takeProfit         Json
  plainText          String?
  editorState        String?
  status             String    @default("open")
  closedAt           DateTime?
  closedPrice        Float?
  closedExchangeRate Float?
  closedReason       String?
  isAutoClosed       Boolean   @default(false)
  // Risk Engine (Phase 1) — populated when a trade is sized/logged/closed via the risk engine.
  capitalExposure    Float?
  capitalExposurePct Float?
  governanceStatus   String?
  // True when the user knowingly logged this trade despite a blocking governance
  // rule (this is a journal, not an execution platform — rules warn, never block).
  overridden         Boolean   @default(false)
  pnl                Float?
  rMultiple          Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  journal            journal[]

  @@index([userId])
  @@index([status, symbol])
}

model riskProfile {
  userId                  String   @id
  user                    user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  maxRiskPerTradePct      Float    @default(1.0)
  maxPortfolioExposurePct Float    @default(3.0)
  maxDailyDrawdownPct     Float    @default(5.0)
  maxWeeklyDrawdownPct    Float    @default(8.0)
  maxMonthlyDrawdownPct   Float    @default(10.0)
  maxOpenTrades           Int      @default(5)
  maxCorrelatedExposure   Float    @default(6.0)
  accountBalance          Decimal  @default(0) @db.Decimal(18, 2)
  lastBalanceSetAt        DateTime @default(now())
  lastBalanceSource       String   @default("manual") // 'manual' | 'trade_close'
  // How the override confirmation is presented when a trade breaks a rule:
  // 'simple' = one acknowledgement; 'detailed' = tick each broken rule.
  overrideMode            String   @default("simple")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model drawdownState {
  userId             String   @id
  user               user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountBalance     Decimal  @db.Decimal(18, 2)
  peakBalance        Decimal  @db.Decimal(18, 2)
  dailyOpenBalance   Decimal  @db.Decimal(18, 2)
  weeklyOpenBalance  Decimal  @db.Decimal(18, 2)
  monthlyOpenBalance Decimal  @db.Decimal(18, 2)
  dailyDrawdownPct   Float    @default(0)
  weeklyDrawdownPct  Float    @default(0)
  monthlyDrawdownPct Float    @default(0)
  allTimeDrawdownPct Float    @default(0)
  dailyBreached      Boolean  @default(false)
  weeklyBreached     Boolean  @default(false)
  monthlyBreached    Boolean  @default(false)
  // The user's local calendar date (YYYY-MM-DD, in their IANA timezone) on which
  // the circuit breakers were last reset. Used by the hourly reset job to fire
  // exactly once per local day — DST-safe and idempotent across retries.
  lastResetLocalDate String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model governanceLog {
  id            String   @id @default(uuid())
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId        String
  tradeId       String?
  overallStatus String
  checksJson    Json
  blockedReason String?
  // True when this log records a trade the user overrode past a blocking rule.
  acknowledged     Boolean  @default(false)
  // The rule keys the user explicitly acknowledged when overriding (e.g.
  // ['maxPortfolioExposure']). Empty unless `acknowledged` is true.
  acknowledgedRules String[]
  // Optional free-text note the user gave for why they overrode the rule(s).
  overrideReason    String?
  aiCoaching    String? // populated asynchronously (Phase 1 Section 15)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([tradeId])
}

model journal {
  id          String   @id @default(uuid())
  userId      String
  symbol      String
  title       String?
  tradeId     String?
  plainText   String?
  trade       trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  editorState String?
  tags        String[]
  author      user     @relation("UserJournal", fields: [userId], references: [id], onDelete: Cascade)
  isPinned    Boolean? @default(false)
  isArchived  Boolean? @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([tradeId])
}

model user {
  id                           String          @id @default(uuid())
  fname                        String          @db.VarChar(256)
  lname                        String          @db.VarChar(256)
  email                        String          @unique @db.VarChar(256)
  role                         String
  tags                         String[]
  language                     String
  password                     String
  accountCurrency              String
  theme                        String          @default("system")
  rules                        Json
  journalEntries               journal[]       @relation("UserJournal")
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  trade                        trade[]
  timezone                     String          @default("UTC")
  togglePipValue               Boolean         @default(false)
  refreshTokens                RefreshToken[]
  auditLogs                    auditLog[]
  riskProfile                  riskProfile?
  drawdownState                drawdownState?
  governanceLogs               governanceLog[]
  deletedAt                    DateTime?
  deleteScheduledFor           DateTime?
  emailVerified                Boolean         @default(false)
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?
  pushTokens                   pushToken[]
  notificationPreference       notificationPreference?
}

/// An Expo push token for one of a user's devices. A user can have many devices;
/// each device's Expo token is unique. We store the platform + a device
/// identifier so a re-registration from the same device updates in place rather
/// than accumulating stale rows, and an `enabled` flag plus `lastErrorAt` so the
/// send pipeline can soft-disable tokens that Expo reports as
/// `DeviceNotRegistered` instead of hard-deleting them immediately.
model pushToken {
  id           String    @id @default(uuid())
  user         user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId       String
  token        String    @unique
  platform     String // 'ios' | 'android' | 'web'
  deviceId     String? // stable per-install id from the client (Device.osBuildId/installationId)
  deviceName   String?
  enabled      Boolean   @default(true)
  lastErrorAt  DateTime?
  lastError    String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
}

/// Per-user notification preferences. One row per user, lazily created with
/// sensible supportive defaults (all categories on, no quiet hours). Quiet hours
/// are stored as local "HH:mm" strings and evaluated against the user's IANA
/// `timezone`, mirroring the drawdown reset's DST-safe local-date approach.
model notificationPreference {
  userId           String   @id
  user             user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // Master switch — when false, no push is sent regardless of category toggles.
  pushEnabled      Boolean  @default(true)
  tradeClosed      Boolean  @default(true)
  coachingReady    Boolean  @default(true)
  drawdownAlerts   Boolean  @default(true)
  governanceAlerts Boolean  @default(true)
  journalReminders Boolean  @default(true)
  // Optional quiet-hours window in the user's local time, "HH:mm" 24h. When both
  // are set, non-urgent notifications are suppressed inside the window.
  quietHoursStart  String?
  quietHoursEnd    String?
  // The user's local hour (0-23) at which the daily journaling nudge fires.
  // Null disables it independently of the `journalReminders` toggle (which the
  // user controls); default 20:00 local is set when the row is created.
  reminderHour     Int      @default(20)
  // The local calendar date (YYYY-MM-DD, user's IANA tz) the journaling reminder
  // last fired. Lets the hourly job send exactly once per local day — DST-safe
  // and idempotent across retries, mirroring drawdownState.lastResetLocalDate.
  lastReminderLocalDate String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  @@index([userId])
}

model auditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       user?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model feedback {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  subject   String
  message   String
  type      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
