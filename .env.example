
DATABASE_URL=""
SHADOW_DATABASE_URL=""
CORS_ORIGIN="http://localhost:8081,https://zenlot.app"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
PORT=4000
MIXPANEL_TOKEN=''
FOREX_API_KEY=""
JWT_SECRET=""
JWT_EXPIRES="3600s"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES="7d"
PRISMA_POSTRES_ZENLOT_DB = ""
EMAIL_HOST=""
EMAIL_PORT=
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
FEEDBACK_EMAIL_RECIPIENT=""
# App entry point for email call-to-action links (e.g. the welcome email's
# "Open Zenlot" button). Defaults to the `zenlot://` custom-scheme deep link,
# which opens the app at Home (the auth gate routes a signed-in user there).
# Switch to a universal/https link here once associatedDomains/intentFilters
# are configured in the client.
APP_URL="zenlot://"
FEEDBACK_RATE_LIMIT_PER_USER_PER_DAY=5

# Risk Engine — AI coaching (Phase 1). Anthropic is primary, OpenAI is the
# fallback. If neither key is set, coaching is silently skipped (non-blocking).
ANTHROPIC_API_KEY=""
ANTHROPIC_COACHING_MODEL="claude-sonnet-4-6"
OPENAI_API_KEY=""
OPENAI_COACHING_MODEL="gpt-4o-mini"
