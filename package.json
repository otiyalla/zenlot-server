{
  "name": "zenlot-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:with:package": "NODE_OPTIONS=--max_old_space_size=4096 yarn build && yarn copy:env:for:package && yarn copy:prisma && yarn copy:migrations && yarn copy:package && yarn sentry:sourcemaps:optional",
    "copy:env": "cp .env dist/.env",
    "copy:env:for:package": "sh -c 'if [ -n \"${BUILD_ENV_FILE:-}\" ] && [ -f \"$BUILD_ENV_FILE\" ]; then cp \"$BUILD_ENV_FILE\" dist/.env; elif [ -f .env ]; then cp .env dist/.env; else touch dist/.env; fi'",
    "copy:prisma": "cp ./prisma/schema.prisma dist/prisma/schema.prisma",
    "copy:migrations": "cp -r ./prisma/migrations dist/prisma/migrations",
    "copy:package": "cp package.json dist/package.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:local": "NODE_ENV=local nest start --watch",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production sh -c 'if [ -f dist/src/main.js ]; then node dist/src/main.js; elif [ -f src/main.js ]; then node src/main.js; else echo \"Could not find production entry point (dist/src/main.js or src/main.js)\" >&2; exit 1; fi'",
    "start:prod:dist": "NODE_ENV=production node dist/src/main.js",
    "start:prod:root": "NODE_ENV=production node src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:migrate:local": "NODE_ENV=local ts-node scripts/migrate-prod.ts",
    "db:migrate:dev": "NODE_ENV=dev ts-node scripts/migrate-prod.ts",
    "db:migrate:prod": "NODE_ENV=prod ts-node scripts/migrate-prod.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:migrate:status:local": "NODE_ENV=local ts-node scripts/migrate-status.ts",
    "db:migrate:status:dev": "NODE_ENV=dev ts-node scripts/migrate-status.ts",
    "db:migrate:status:prod": "NODE_ENV=prod ts-node scripts/migrate-status.ts",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:dev": "prisma db push && ts-node prisma/seed.ts",
    "db:dev:start": "yarn db:dev && yarn start:dev",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "db:reset": "prisma migrate reset --force --skip-seed --skip-generate --config prisma/prisma.config.ts",
    "db:docker:rebuild": "docker-compose down && docker-compose up -d && docker exec zenlot-db psql -U zenlot -d zenlot -c \"DO $$ DECLARE r RECORD; BEGIN FOR r IN SELECT tablename FROM pg_tables WHERE schemaname = 'public' LOOP EXECUTE 'ALTER TABLE ' || quote_ident(r.tablename) || ' COLLATE DEFAULT'; END LOOP; END $$;\" && docker exec zenlot-db psql -U zenlot -d template1 -c \"ALTER DATABASE template1 REFRESH COLLATION VERSION;\" && yarn db:migrate",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org zenlot --project node-nestjs ./dist && sentry-cli sourcemaps upload --org zenlot --project node-nestjs ./dist",
    "sentry:sourcemaps:optional": "sh -c 'if [ -n \"${SENTRY_AUTH_TOKEN:-}\" ]; then yarn sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.3",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/cli": "^2",
    "@sentry/nestjs": "^10.36.0",
    "@sentry/profiling-node": "^10.36.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.66.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^4.23.2",
    "financialmodelingprep": "^1.1.0",
    "ioredis": "^5.3.3",
    "mixpanel": "^0.18.1",
    "nodemailer": "^7.0.12",
    "openai": "^6.42.0",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.0.0"
  },
  "packageManager": "yarn@4.16.0"
}
